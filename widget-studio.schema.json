{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native widget Studio panels",
  "description": "Embed in widget.json widgets[].studio. scripts/widget_studio_contract.py enforces renderer-specific keys/types/choices, approved sources/provider fields and size limits. Requires Studio 0.49.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api"
  ],
  "anyOf": [
    {
      "required": [
        "settings"
      ]
    },
    {
      "required": [
        "connection"
      ]
    }
  ],
  "properties": {
    "api": {
      "enum": [
        1,
        2
      ]
    },
    "settings": {
      "$ref": "settings.schema.json"
    },
    "help": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drive": {
          "const": "pc.drives"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "title",
        "manageLabel",
        "itemLabel",
        "setupHelp",
        "provider",
        "key",
        "fields"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "manageLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "itemLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "setupHelp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "provider": {
          "const": "bambu-lan"
        },
        "key": {
          "const": "printerId"
        },
        "fields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "type"
            ],
            "properties": {
              "key": {
                "enum": [
                  "name",
                  "host",
                  "serial",
                  "code",
                  "controls"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "enum": [
                  "string",
                  "secret",
                  "boolean"
                ]
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "required": {
                "type": "boolean"
              },
              "help": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "source",
        "presets"
      ],
      "properties": {
        "api": {
          "const": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "key"
          ],
          "properties": {
            "scope": {
              "enum": [
                "setting",
                "connection"
              ]
            },
            "key": {
              "type": "string"
            }
          }
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "artwork": {
                "type": "array",
                "maxItems": 64
              },
              "splitFlap": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plateColor",
                  "durationMs"
                ],
                "properties": {
                  "plateColor": {
                    "type": "string",
                    "pattern": "^#[a-fA-F0-9]{6}$"
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 600
                  },
                  "plateColorSetting": {
                    "type": "string"
                  }
                }
              },
              "minTemperatureRows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "nozzleGrid": {
                "type": "object",
                "required": [
                  "materialSize",
                  "swatchSize",
                  "verticalInset"
                ],
                "additionalProperties": false,
                "properties": {
                  "materialSize": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 20
                  },
                  "swatchSize": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 22
                  },
                  "verticalInset": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 14
                  }
                }
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "large",
        "small"
      ],
      "properties": {
        "large": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "op",
              "box"
            ],
            "properties": {
              "op": {
                "enum": [
                  "text",
                  "rect",
                  "time",
                  "bar",
                  "image"
                ]
              },
              "box": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "small": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "op",
              "box"
            ],
            "properties": {
              "op": {
                "enum": [
                  "text",
                  "rect",
                  "time",
                  "bar",
                  "image"
                ]
              },
              "box": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
