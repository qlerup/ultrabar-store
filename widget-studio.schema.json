{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native widget Studio panels",
  "description": "Embed in widget.json widgets[].studio. scripts/widget_studio_contract.py enforces renderer-specific keys/types/choices, approved sources/provider fields and size limits. Requires Studio 0.49.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api"
  ],
  "anyOf": [
    {
      "required": [
        "settings"
      ]
    },
    {
      "required": [
        "connection"
      ]
    },
    {
      "required": [
        "layout"
      ]
    }
  ],
  "properties": {
    "api": {
      "enum": [
        1,
        2
      ]
    },
    "settings": {
      "$ref": "settings.schema.json"
    },
    "help": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drive": {
          "const": "pc.drives"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "title",
        "manageLabel",
        "itemLabel",
        "setupHelp",
        "provider",
        "key",
        "fields"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "manageLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "itemLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "setupHelp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "provider": {
          "const": "bambu-lan"
        },
        "key": {
          "const": "printerId"
        },
        "fields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "type"
            ],
            "properties": {
              "key": {
                "enum": [
                  "name",
                  "host",
                  "serial",
                  "code",
                  "controls"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "enum": [
                  "string",
                  "secret",
                  "boolean"
                ]
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "required": {
                "type": "boolean"
              },
              "help": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "source",
        "presets"
      ],
      "properties": {
        "api": {
          "const": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "key"
          ],
          "properties": {
            "scope": {
              "enum": [
                "setting",
                "connection"
              ]
            },
            "key": {
              "type": "string"
            }
          }
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "artwork": {
                "type": "array",
                "maxItems": 64
              },
              "splitFlap": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plateColor",
                  "durationMs"
                ],
                "properties": {
                  "plateColor": {
                    "type": "string",
                    "pattern": "^#[a-fA-F0-9]{6}$"
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 600
                  },
                  "plateColorSetting": {
                    "type": "string"
                  }
                }
              },
              "minTemperatureRows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "nozzleGrid": {
                "type": "object",
                "required": [
                  "materialSize",
                  "swatchSize",
                  "verticalInset"
                ],
                "additionalProperties": false,
                "properties": {
                  "materialSize": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 20
                  },
                  "swatchSize": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 22
                  },
                  "verticalInset": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 14
                  },
                  "sideTemperatures": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,30}_temper$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "large",
        "small"
      ],
      "properties": {
        "large": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "required": [
                  "op",
                  "box"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "text",
                      "rect",
                      "time",
                      "bar",
                      "image"
                    ]
                  },
                  "box": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "elements"
              ],
              "properties": {
                "elements": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "$ref": "#/$defs/panelNode"
                  }
                }
              }
            }
          ]
        },
        "small": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "required": [
                  "op",
                  "box"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "text",
                      "rect",
                      "time",
                      "bar",
                      "image"
                    ]
                  },
                  "box": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "elements"
              ],
              "properties": {
                "elements": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "$ref": "#/$defs/panelNode"
                  }
                }
              }
            }
          ]
        },
        "expanded": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/panelNode"
          }
        }
      }
    },
    "sounds": {
      "type": "object",
      "description": "Named tone sequences. Each note is frequency in Hz and duration in milliseconds, with an optional third value of bell. Maximum total 580 ms per event."
    },
    "notifications": {
      "type": "object",
      "description": "Core banners for events emitted by the widget's trusted provider. Messages can include the {source} display name.",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_.]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "message", "kind"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 80},
            "message": {"type": "string", "minLength": 1, "maxLength": 200},
            "kind": {"enum": ["info", "success", "warning"]}
          }
        }
      }
    }
  },
  "$defs": {
    "panelNode": {
      "type": "object",
      "required": [
        "op",
        "box"
      ],
      "properties": {
        "op": {
          "enum": [
            "bar",
            "text",
            "swatch",
            "rect",
            "grid",
            "group"
          ]
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panelNode"
          }
        }
      }
    }
  }
}
