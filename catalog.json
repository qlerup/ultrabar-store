          },
          {
            "key": "showSeconds",
            "label": "Show seconds",
            "help": "Use the matching six-flap clock face with live seconds.",
            "type": "boolean",
            "default": false
          },
          {
            "key": "idleDelay",
            "label": "Show screensaver after",
            "help": "How long Core has been idle before displaying the clock. Screen sleep is separate.",
