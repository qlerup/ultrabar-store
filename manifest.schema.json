{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UltraBar package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "type",
    "license",
    "source",
    "compatibility",
    "permissions",
    "artifact",
    "description",
    "icon",
    "publisher"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "type": {
      "enum": [
        "corebar-app",
        "corebar-widget",
        "studio-plugin"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "pattern": "^https://github.com/"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "minStudioVersion",
        "hostApi",
        "models",
        "lineosVersions",
        "abis"
      ],
      "properties": {
        "minStudioVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "hostApi": {
          "const": 1
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CB01"
            ]
          }
        },
        "lineosVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "1.0.8",
              "1.0.9"
            ]
          }
        },
        "abis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "armeabi-v7a"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "url",
        "size",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^/]+/[^/]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "android": {
      "type": "object",
      "required": [
        "packageId",
        "versionCode",
        "minSdk",
        "signerSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "minSdk": {
          "type": "integer",
          "minimum": 26,
          "maximum": 29
        },
        "signerSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "size",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github.com/qlerup/ultrabar-store/releases/download/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*\\.png$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "publisher": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
    },
    "bundledWidgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widgetApi", "runtime", "widgets"],
      "properties": {
        "widgetApi": {"const": 1},
        "runtime": {"const": "studio-native-v1"},
        "widgets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object"}}
      }
    },
    "settings": {
      "$ref": "settings.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "corebar-app"
          }
        }
      },
      "then": {
        "required": [
          "android"
        ]
      },
      "else": {
        "not": {
          "required": [
            "android"
          ]
        }
      }
    }
  ]
}
