{
  "widgetApi": 1,
  "runtime": "studio-native-v1",
  "widgets": [
    {
      "id": "clock",
      "name": "Clock & date",
      "kind": "clock",
      "background": "#171919",
      "textColor": "#f5f0df",
      "accent": "#dfb37b",
      "hourFormat": "24",
      "showSeconds": true,
      "showDate": true,
      "studio": {
        "api": 1,
        "help": "Uses Core time and locale; editor preview uses PC time. Keep Studio connected to restore the widget after Core restarts.",
        "settings": {
          "api": 1,
          "fields": [
            {
              "key": "hourFormat",
              "label": "Time format",
              "type": "choice",
              "default": "24",
              "options": [
                {
                  "value": "12",
                  "label": "12-hour"
                },
                {
                  "value": "24",
                  "label": "24-hour"
                }
              ]
            },
            {
              "key": "showSeconds",
              "label": "Show seconds",
              "type": "boolean",
              "default": true
            },
            {
              "key": "showDate",
              "label": "Show date",
              "type": "boolean",
              "default": true
            }
          ]
        },
        "presentation": {
          "api": 1,
          "source": {
            "scope": "setting",
            "key": "hourFormat"
          },
          "presets": [
            {
              "value": "12",
              "splitFlap": {
                "plateColor": "#353839",
                "durationMs": 360
              }
            },
            {
              "value": "24",
              "splitFlap": {
                "plateColor": "#353839",
                "durationMs": 360
              }
            }
          ]
        }
      },
      "sizes": [
        "large",
        "small"
      ]
    }
  ]
}
