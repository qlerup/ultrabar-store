{
  "widgetApi": 1,
  "runtime": "studio-native-v1",
  "widgets": [
    {
      "id": "system-monitor",
      "name": "System Monitor",
      "kind": "cpu",
      "kindOptions": [
        "cpu",
        "memory",
        "gpu"
      ],
      "background": "#192325",
      "textColor": "#eef6f2",
      "accent": "#94d9bb",
      "studio": {
        "api": 1,
        "help": "CPU, RAM and GPU readings describe this PC. GPU readings require NVIDIA nvidia-smi; unavailable sensors show unavailable.",
        "settings": {
          "api": 1,
          "fields": [
            {
              "key": "kind",
              "label": "Show",
              "type": "choice",
              "default": "cpu",
              "options": [
                {
                  "value": "cpu",
                  "label": "CPU usage"
                },
                {
                  "value": "memory",
                  "label": "RAM usage"
                },
                {
                  "value": "gpu",
                  "label": "GPU usage"
                }
              ]
            }
          ]
        }
      },
      "sizes": [
        "large",
        "small"
      ]
    }
  ]
}
