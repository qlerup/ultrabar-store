{
  "schemaVersion": 1,
  "id": "studio.bambu.panel",
  "name": "Bambu Panel",
  "description": "One installation for local Bambu Lab printer discovery, setup and a native liquid home widget. Choose readings in Studio; unfold across 2?5 slots while neighbors move. Access codes stay on Core. Requires Studio 0.46 and compatible LAN firmware.",
  "version": "1.0.0",
  "type": "corebar-app",
  "license": "MIT",
  "publisher": "qlerup",
  "source": "https://github.com/qlerup/ultrabar-bambu-panel/blob/91a8b310425e8826f9ae0ee1ce4b0cea362928aa/AndroidManifest.xml",
  "compatibility": {
    "minStudioVersion": "0.46.0",
    "hostApi": 1,
    "models": [
      "CB01"
    ],
    "lineosVersions": [
      "1.0.9"
    ],
    "abis": [
      "armeabi-v7a"
    ]
  },
  "permissions": [
    "android.permission.INTERNET",
    "android.permission.FOREGROUND_SERVICE"
  ],
  "android": {
    "packageId": "dk.ultrabar.bambu",
    "versionCode": 100,
    "minSdk": 26,
    "signerSha256": "3421efe203846a4074d48ab0b7f3c7be23784f04eef7914d4b84c943711f2796"
  },
  "artifact": {
    "url": "https://github.com/qlerup/ultrabar-store/releases/download/review-bambu-panel-1.0.0/app.apk",
    "size": 57951,
    "sha256": "3eafefbd628378f895d05220821df66cc05f59cbf4c85a06838f94d1d76678f5"
  },
  "icon": {
    "url": "https://github.com/qlerup/ultrabar-store/releases/download/review-bambu-panel-1.0.0/icon.png",
    "size": 11485,
    "sha256": "6c55cb63db1f36c7f58a1e29cbda82cf5d9bfcf8030ce19bdba884a5befa50c2"
  },
  "settings": {
    "api": 1,
    "fields": [
      {
        "key": "printerName",
        "label": "Panel title",
        "type": "string",
        "default": "Bambu Lab",
        "maxLength": 48
      },
      {
        "key": "allowControls",
        "label": "Enable printer controls",
        "help": "Allows pause, resume, stop and chamber light. Requires local setup and compatible printer firmware. Off by default.",
        "type": "boolean",
        "default": false
      },
      {
        "key": "showTemperatures",
        "label": "Show temperatures",
        "type": "boolean",
        "default": true
      },
      {
        "key": "keepScreenOn",
        "label": "Keep screen awake while panel is open",
        "type": "boolean",
        "default": false
      }
    ]
  },
  "bundledWidgets": {
    "widgetApi": 1,
    "runtime": "studio-native-v1",
    "widgets": [
      {
        "id": "bambu-liquid",
        "name": "Bambu Liquid",
        "kind": "bambu",
        "background": "#14202b",
        "textColor": "#eff6fa",
        "accent": "#86e4c3",
        "primary": "progress",
        "secondary": "remaining",
        "expandedSlots": 3,
        "showJob": true,
        "showTemperatures": true,
        "showLayers": true,
        "showRemaining": true,
        "showControls": true,
        "liquidMotion": true
      }
    ]
  }
